{
  "$schema": "https://raw.githubusercontent.com/Azure/static-web-apps/main/schema/staticwebapp.config.schema.json",
  "routes": [
    { "route": "/markhazleton", "redirect": "/markhazleton/card/", "statusCode": 301 },
    { "route": "/lesleyhazleton", "redirect": "/lesleyhazleton/card/", "statusCode": 301 },
    { "route": "/contacts/*.vcf", "headers": { "cache-control": "public, max-age=86400" } },
    { "route": "/styles.css", "headers": { "cache-control": "public, max-age=3600, must-revalidate" } },
    { "route": "/*.{png,jpg,jpeg,svg,ico,webp}", "headers": { "cache-control": "public, max-age=2592000, immutable" } },
    { "route": "/*.mp4", "headers": { "cache-control": "public, max-age=2592000, immutable" } },
    { "route": "/.well-known/security.txt", "headers": { "content-type": "text/plain" } }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/*.{png,jpg,jpeg,svg,ico,webp,css,js,vcf,txt,xml,mp4}", "/.well-known/*"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "mimeTypes": {
    ".vcf": "text/vcard",
    ".webmanifest": "application/manifest+json",
    ".mp4": "video/mp4"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
